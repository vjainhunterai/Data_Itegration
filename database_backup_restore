#!/bin/sh

# Restore MySQL dump into RDS instance
mysql -h $MYSQL_HOST -P $MYSQL_PORT -u $MYSQL_USER -p"$MYSQL_PASSWORD" $MYSQL_DATABASE < $MYSQL_DUMP_FILE



